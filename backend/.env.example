# DeepSeek API Key。留空时后端自动进入本地演示模式（不调用大模型）。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 检索参数
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=4
MAX_UPLOAD_MB=20

# Agent 循环参数
AGENT_MAX_STEPS=4
AGENT_TOOL_TIMEOUT=5
AGENT_MAX_CONTEXTS=12

# 数据目录，相对于 backend/ 目录
DATA_DIR=data

# LLM 模式：llm（默认，真实调用）/ replay（回放 eval/fixtures 中的录制）/ demo（不调模型）
# LLM_MODE=replay

# 项目定向测评的题量（默认：学习 ≥20、考试 10、复练 ≥10）
PRACTICE_BATCH_SIZE=8
PRACTICE_MIN_TOTAL=20
EXAM_QUESTION_COUNT=10
EXAM_CANDIDATE_COUNT=22
REVIEW_ITEMS_MIN=10
